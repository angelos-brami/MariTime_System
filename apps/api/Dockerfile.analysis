FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/model-cache \
    SENTENCE_TRANSFORMERS_HOME=/app/model-cache

RUN addgroup --system eastmed && adduser --system --ingroup eastmed eastmed

WORKDIR /app
COPY pyproject.toml README.md ./
COPY apps/api ./apps/api
COPY packages ./packages
COPY config ./config
COPY prompts ./prompts
RUN pip install --no-cache-dir ".[embeddings]"
RUN mkdir -p /app/model-cache && chown -R eastmed:eastmed /app/model-cache

USER eastmed
CMD ["eastmed-embedding-worker"]
